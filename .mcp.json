{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GYM_APP_TOKEN}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions"
      }
    },
    "penpot": {
      "type": "http",
      "url": "https://design.penpot.app/mcp/stream?userToken=${PENPOT_MCP_TOKEN}"
    }
  }
}
